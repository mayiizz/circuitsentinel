# Copy to .env for local development. Never commit .env.

# Bearer token required by POST /mcp. Replace with a local secret; never commit a real value.
CIRCUITSENTINEL_MCP_TOKEN=

# Max schematic upload size in megabytes (server-enforced). Default: 20.
CIRCUITSENTINEL_MAX_UPLOAD_MB=20

# Optional audit actor label for HITL approve/reject (dashboard has no auth).
# Default when unset: local-operator. Do not expose approve endpoints to untrusted networks.
# CIRCUITSENTINEL_HITL_ACTOR=local-operator

# Assistant (LangGraph): demo requires no credentials; llm uses Groq.
# CIRCUITSENTINEL_AGENT_MODE=demo
# CIRCUITSENTINEL_AGENT_MODE=llm
# CIRCUITSENTINEL_MODEL_PROVIDER=groq
# CIRCUITSENTINEL_MODEL=qwen/qwen3.8-27b
# GROQ_API_KEY=

# Bind local API to loopback (recommended). Example:
# uvicorn app.main:app --host 127.0.0.1 --port 8000

# Optional absolute path to kicad-cli (overrides PATH / macOS app bundle lookup).
# Example on macOS: /Applications/KiCad/KiCad.app/Contents/MacOS/kicad-cli
# CIRCUITSENTINEL_KICAD_CLI=
