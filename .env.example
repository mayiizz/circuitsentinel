# Copy to .env for local development. Never commit .env.
# ArmorIQ resolves a key from this variable, then from ~/.armoriq/credentials.json.
# Leave it empty until authentication is verified. The health endpoint does not need it.
ARMORIQ_API_KEY=

# Bearer token required by POST /mcp. Replace with a local secret; never commit a real value.
CIRCUITSENTINEL_MCP_TOKEN=

# Max schematic upload size in megabytes (server-enforced). Default: 20.
CIRCUITSENTINEL_MAX_UPLOAD_MB=20

# Optional absolute path to kicad-cli (overrides PATH / macOS app bundle lookup).
# Example on macOS: /Applications/KiCad/KiCad.app/Contents/MacOS/kicad-cli
# CIRCUITSENTINEL_KICAD_CLI=
